# DuesWise AI service configuration.
# Copy to .env for local development. Never commit a real .env or a real API key.

APP_ENV=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# none | openai_compatible | openai | groq
# With AI_PROVIDER=none every endpoint uses deterministic local logic.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Leave empty to use the provider default base URL (openai: https://api.openai.com/v1,
# groq: https://api.groq.com/openai/v1). Any OpenAI-compatible endpoint is accepted.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=1

# Comma-separated origins. Empty means the CORS middleware is not installed.
CORS_ALLOW_ORIGINS=
