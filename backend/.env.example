# DuesWise backend environment configuration (development defaults only).
# Copy this file to `.env` and adjust as needed.
# Never commit real secrets, credentials, or real personal/banking data.

DATABASE_URL=sqlite:///./dueswise.db
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
APP_NAME=DuesWise
APP_VERSION=1.0.0

# AI service (Developer B). Optional; backend must work without it.
AI_SERVICE_BASE_URL=http://localhost:8001
AI_TIMEOUT_SECONDS=5
AI_MAX_RETRIES=1
AI_ENABLED=false

DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
FORECAST_HORIZON_DAYS=30
SAFETY_RESERVE_PERCENT=10
MAX_NUDGES_PER_7_DAYS=3
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
